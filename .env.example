# Local-only configuration. Authentication provisions its signing key locally.
# Model selection is optional; blank means manual/local heuristic mode.
OLLAMA_MODEL=llama3.2:3b
OLLAMA_URL=http://127.0.0.1:11434
# Full inference deadline (milliseconds), including cold model loading.
OLLAMA_TIMEOUT_MS=120000
PIST_DATA_DIR=
HOST=127.0.0.1
PORT=3000
# For an existing credential file with multiple users, explicitly select its sole local owner.
PIST_OWNER_USERNAME=
