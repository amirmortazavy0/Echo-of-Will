{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx server.ts",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "vite build",
    "build:backend": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node --env-file-if-exists=.env scripts/start-production.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "test:regression": "node --import tsx --test tests/regression.test.ts tests/storage.test.ts tests/domain.test.ts tests/evidence.test.ts",
    "test:startup": "node --test tests/startup.test.mjs",
    "test:e2e": "playwright test",
    "test:qa": "npm run typecheck && npm run test:regression && npm run build && npm run test:startup && npm run test:integration && node scripts/verify-baseline.mjs",
    "storage:migrate": "node --env-file-if-exists=.env --import tsx scripts/storage-migrate.ts",
    "test:integration": "node --import tsx --test tests/repair-integration.test.mjs tests/capture-integration.test.ts"
  },
  "engines": {
    "node": ">=22.20.0 <23",
    "npm": ">=10 <11"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "concurrently": "^10.0.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0"
  },
  "allowScripts": {
    "esbuild": true,
    "protobufjs": true
  }
}
